# Copia este archivo como .env y ajusta los valores.
# El archivo .env NO se sube al repositorio.

# Puerto donde escucha la API
PORT=3000

# Base de datos (los usa docker-compose.yml y la API)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=easybus
DB_USER=easybus
DB_PASSWORD=cambia_esta_clave

# Las tablas se crean y modifican con migraciones (npm run migration:run).
# Ya no se usa DB_SYNC: TypeORM nunca ajusta las tablas por su cuenta.

# Autenticación JWT
# Clave secreta para firmar los tokens (en producción: larga y aleatoria)
JWT_SECRET=cambia_esta_clave_larga_y_aleatoria
# Duración del token de acceso, en segundos (3600 = 1 hora)
JWT_EXPIRES_IN=3600

# Administrador inicial: se crea al arrancar la API si no existe
ADMIN_NOMBRE=Administrador EASYBUS
ADMIN_CORREO=admin@easybus.co
ADMIN_PASSWORD=cambia_esta_clave
