# EASYBUS en producción. En la VM: cp .env.production.example .env
# y cambia TODOS los valores "CAMBIAR". El archivo .env nunca se sube a Git.
# Generar una clave aleatoria en la VM:  openssl rand -hex 32

# Para escribir "docker compose ..." sin "-f docker-compose.prod.yml"
COMPOSE_FILE=docker-compose.prod.yml

# Nombre público del servidor (DNS de la IP estática de Azure). Caddy pide el
# certificado HTTPS para este nombre. Sin "https://" ni "/" al final.
EASYBUS_HOST=easybus-unicordoba.northcentralus.cloudapp.azure.com

# Base de datos (solo visible dentro de Docker)
DB_NAME=easybus
DB_USER=easybus
DB_PASSWORD=CAMBIAR_clave_larga_de_la_base

# Autenticación JWT: clave larga y aleatoria, distinta a la de tu computador
JWT_SECRET=CAMBIAR_openssl_rand_hex_32
# Duración del token de acceso, en segundos (3600 = 1 hora)
JWT_EXPIRES_IN=3600

# Administrador inicial: solo se crea si la base no tiene administrador.
# Si migras tu base local (DESPLIEGUE.md, paso 9), queda tu administrador de siempre
# con su clave de siempre, y estos valores no se usan.
ADMIN_NOMBRE=Administrador EASYBUS
ADMIN_CORREO=admin@easybus.co
ADMIN_PASSWORD=CAMBIAR_clave_del_administrador

# Respaldo diario (servicio "respaldo"): hora de Bogotá y días que se guardan
HORA_RESPALDO=3
DIAS_RESPALDO=7

# Ya fijados en docker-compose.prod.yml (no hace falta ponerlos aquí):
# NODE_ENV=production, DB_HOST=postgres, SWAGGER_ENABLED=false, TRUST_PROXY=1,
# CORS_ORIGINS=https://$EASYBUS_HOST, UPLOADS_DIR=/app/uploads
